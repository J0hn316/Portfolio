---
import { siteConfig } from "../../config/site";
const currentYear: number = new Date().getFullYear();

const footerLinks = [
  { label: "Home", href: "/" },
  { label: "Projects", href: "/projects/" },
  { label: "Contact", href: "/#contact" },
];
---

<footer class="border-t border-border bg-surface">
  <div class="site-container py-10">
    <div class="flex flex-col justify-between gap-8 sm:flex-row">
      <!-- Professional identity -->
      <div class="space-y-2">
        <p class="font-semibold tracking-tight">Developer Portfolio</p>

        <p class="text-sm text-muted">{siteConfig.tagline}</p>
      </div>

      <!-- Footer navigation -->
      <nav aria-label="Footer navigation">
        <ul class="flex flex-wrap gap-x-6 gap-y-3">
          {footerLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-muted transition-colors
                         hover:text-primary
                         focus-visible:text-primary"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Professional profiles">
        <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
          {siteConfig.socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
                class="inline-flex min-h-11 items-center text-sm
                   text-muted underline-offset-4
                   transition-colors hover:text-primary
                   hover:underline"
              >
                {link.label}
                {link.external && (
                  <span class="sr-only"> (opens in a new tab)</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div
      class="mt-8 flex flex-col justify-between gap-3
             border-t border-border pt-6 sm:flex-row"
    >
      <p class="text-sm text-muted">
        &copy; {currentYear} Developer Portfolio. All rights reserved.
      </p>

      <p class="text-sm text-muted">Built with Astro & TypeScript</p>
    </div>
  </div>
</footer>
