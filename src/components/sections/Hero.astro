---
const featuredTechnologies: string[] = [
  "TypeScript",
  "Python",
  "React",
  "Django",
  "Vuejs",
  "React Native",
];
---

<section
  id="home"
  aria-labelledby="hero-heading"
  class="scroll-mt-24 py-20 sm:py-28 lg:py-36"
>
  <div class="max-w-3xl space-y-8">
    <!-- Professional identity -->
    <p
      class="flex items-center gap-3 font-mono
             text-sm font-medium tracking-wide text-primary"
    >
      <span aria-hidden="true" class="size-2 rounded-full bg-primary"></span>
      SOFTWARE DEVELOPMENT + IT
    </p>

    <!-- Main headline -->
    <h1
      id="hero-heading"
      class="text-4xl font-bold tracking-tight
             text-foreground sm:text-5xl lg:text-6xl"
    >
      Building practical
      <span class="text-primary"> software solutions.</span>
    </h1>

    <!-- Introduction -->
    <p
      class="max-w-2xl text-lg leading-relaxed
             text-muted sm:text-xl"
    >
      I'm a software developer with professional IT experience, focused on
      building web applications, automation tools, and reliable technical
      solutions.
    </p>

    <!-- Calls to action -->
    <div class="flex flex-wrap items-center gap-4">
      <a
        href="#projects"
        class="inline-flex min-h-11 items-center
               justify-center rounded-lg bg-blue-700
               px-6 py-3 font-semibold text-white
               transition-colors hover:bg-blue-800
               focus-visible:outline-offset-4"
      >
        View Projects
        <span aria-hidden="true" class="ml-2">
          &rarr;
        </span>
      </a>

      <a
        href="#about"
        class="inline-flex min-h-11 items-center
               justify-center rounded-lg border border-border
               bg-surface px-6 py-3 font-semibold
               text-foreground transition-colors
               hover:bg-background
               focus-visible:outline-offset-4"
      >
        About Me
      </a>
    </div>

    <!-- Technology highlights -->
    <div class="border-t border-border pt-8">
      <p class="mb-4 text-sm font-medium text-muted">
        Technologies I work with
      </p>

      <ul class="flex flex-wrap gap-3">
        {featuredTechnologies.map((technology) => (
          <li
            class="rounded-lg border border-border
                     bg-surface px-3 py-2 font-mono
                     text-sm text-foreground"
          >
            {technology}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
