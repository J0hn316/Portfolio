---
import { getCollection } from "astro:content";
import ProjectCard from "../ui/ProjectCard.astro";

// Retrieve only projects marked as featured.
const featuredProjects = await getCollection(
  "projects",
  ({ data }) => data.featured,
);

// Sort projects by their configured display order.
// The project ID provides a stable tie-breaker.
featuredProjects.sort(
  (a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id),
);
---

<section
  id="projects"
  aria-labelledby="projects-heading"
  class="scroll-mt-24 border-t border-border py-20 sm:py-28"
>
  <div class="mb-12 max-w-3xl space-y-5">
    <p class="font-mono text-sm font-medium tracking-wide text-primary">
      FEATURED WORK
    </p>

    <h2
      id="projects-heading"
      class="text-3xl font-bold tracking-tight
             text-foreground sm:text-4xl"
    >
      Projects I've built
    </h2>

    <p class="leading-relaxed text-muted">
      A selection of applications and tools that demonstrate my experience with
      backend development, databases, testing, and technical problem-solving.
    </p>
  </div>

  <div class="grid gap-6 md:grid-cols-2">
    {featuredProjects.map((project) => (
      <ProjectCard
        id={project.id}
        title={project.data.title}
        category={project.data.category}
        description={project.data.description}
        highlights={project.data.highlights}
        technologies={project.data.technologies}
        repositoryUrl={project.data.repositoryUrl}
      />
    ))}
  </div>
</section>
