---
import { render, getCollection, type CollectionEntry } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: {
      id: project.id,
    },
    props: {
      project,
    },
  }));
}

const { project } = Astro.props;

const { Content } = await render(project);

const {
  title,
  description,
  category,
  technologies,
  highlights,
  status,
  repositoryUrl,
  demoUrl,
} = project.data;

const statusLabels: Record<
  CollectionEntry<"projects">["data"]["status"],
  string
> = {
  completed: "Completed",
  "in-progress": "In Progress",
  archived: "Archived",
};
---

<BaseLayout title={`${title} | Projects`} description={description}>
  <main id="main-content" tabindex="-1" class="site-container py-16 sm:py-24">
    <article class="space-y-12">
      <!-- Project introduction -->
      <header class="max-w-3xl space-y-5">
        <a
          href="/projects/"
          class="inline-flex min-h-11 items-center font-medium
                 text-primary underline-offset-4 hover:underline"
        >
          <span aria-hidden="true" class="mr-2">
            &larr;
          </span>
          All Projects
        </a>

        <p class="font-mono text-sm font-medium text-primary">{category}</p>

        <h1
          class="text-4xl font-bold tracking-tight text-foreground
                 sm:text-5xl"
        >
          {title}
        </h1>

        <p class="text-lg leading-relaxed text-muted">{description}</p>

        <p class="text-sm text-muted">
          Project status:
          <span class="font-medium text-foreground">
            {statusLabels[status]}
          </span>
        </p>

        <ul class="flex flex-wrap gap-2" aria-label="Technologies used">
          {technologies.map((technology) => (
            <li
              class="rounded-md border border-border
                       bg-surface px-3 py-1.5 text-sm"
            >
              {technology}
            </li>
          ))}
        </ul>

        {(repositoryUrl || demoUrl) && (
          <div class="flex flex-wrap gap-4 pt-2">
            {repositoryUrl && (
              <a
                href={repositoryUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-primary hover:underline"
              >
                View Repository
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            )}

            {demoUrl && (
              <a
                href={demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-primary hover:underline"
              >
                Live Demo
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            )}
          </div>
        )}
      </header>

      <!-- Technical highlights -->
      <section aria-labelledby="highlights-heading" class="max-w-3xl space-y-5">
        <h2
          id="highlights-heading"
          class="text-2xl font-bold tracking-tight text-foreground"
        >
          Technical Highlights
        </h2>

        <ul class="list-disc space-y-3 pl-6 text-muted">
          {highlights.map((highlight) => (
            <li class="leading-relaxed">{highlight}</li>
          ))}
        </ul>
      </section>

      <!-- Render the project's Markdown case study -->
      <section
        aria-label="Project case study"
        class="max-w-3xl border-t border-border pt-8"
      >
        <div class="case-study-content">
          <Content />
        </div>
      </section>
    </article>
  </main>
</BaseLayout>
