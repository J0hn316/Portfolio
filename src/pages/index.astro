---
import BaseLayout from "../layouts/BaseLayout.astro";

import Hero from "../components/sections/Hero.astro";
import About from "../components/sections/About.astro";
import Skills from "../components/sections/Skills.astro";
import Contact from "../components/sections/Contact.astro";
import Experience from "../components/sections/Experience.astro";
import FeaturedProjects from "../components/sections/FeaturedProjects.astro";
---

<BaseLayout
  title="Software Developer & IT Professional | Portfolio"
  description="Explore my software development projects, technical skills, and professional IT experience."
>
  <main id="main-content" tabindex="-1" class="site-container">
    <Hero />
    <About />
    <Skills />
    <Experience />
    <FeaturedProjects />
    <Contact />
  </main>
</BaseLayout>
