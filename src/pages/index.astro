
---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Software Developer & IT Professional | Portfolio"
  description="Explore my software development projects, technical skills, and professional IT experience."
>
  
<main
  id="home"
  class="mx-auto max-w-6xl px-6 py-16"
>
  <section class="space-y-5">
    <p class="font-mono text-sm text-primary">
      SOFTWARE DEVELOPMENT / IT
    </p>

    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
      Building practical software solutions.
    </h1>

    <p class="max-w-2xl text-lg text-muted">
      Welcome to my developer and IT portfolio.
      This homepage is currently under construction.
    </p>
  </section>

  <section id="about" class="mt-24 scroll-mt-24">
    <h2 class="text-2xl font-semibold">About</h2>
    <p class="mt-3 text-muted">
      My professional background and development journey.
    </p>
  </section>

  <section id="skills" class="mt-24 scroll-mt-24">
    <h2 class="text-2xl font-semibold">Skills</h2>
    <p class="mt-3 text-muted">
      Technologies and tools I work with.
    </p>
  </section>

  <section id="experience" class="mt-24 scroll-mt-24">
    <h2 class="text-2xl font-semibold">Experience</h2>
    <p class="mt-3 text-muted">
      My professional IT and software development experience.
    </p>
  </section>

  <section id="projects" class="mt-24 scroll-mt-24">
    <h2 class="text-2xl font-semibold">Projects</h2>
    <p class="mt-3 text-muted">
      Featured applications, automation tools,
      and technical case studies.
    </p>
  </section>

  <section id="contact" class="mt-24 scroll-mt-24">
    <h2 class="text-2xl font-semibold">Contact</h2>
    <p class="mt-3 text-muted">
      Professional contact information and profile links.
    </p>
  </section>
</main>

</BaseLayout>
