---
import BaseLayout from "../layouts/BaseLayout.astro";

import Hero from "../components/sections/Hero.astro";
import About from "../components/sections/About.astro";
---

<BaseLayout
  title="Software Developer & IT Professional | Portfolio"
  description="Explore my software development projects, technical skills, and professional IT experience."
>
  <main class="site-container">
    <Hero />
    <About />

    <section id="skills" class="scroll-mt-24 py-20">
      <h2 class="text-2xl font-semibold">Skills</h2>
      <p class="mt-3 text-muted">Technologies and tools I work with.</p>
    </section>

    <section id="experience" class="scroll-mt-24 py-20">
      <h2 class="text-2xl font-semibold">Experience</h2>
      <p class="mt-3 text-muted">
        My professional IT and software development experience.
      </p>
    </section>

    <section id="projects" class="scroll-mt-24 py-20">
      <h2 class="text-2xl font-semibold">Projects</h2>
      <p class="mt-3 text-muted">
        Featured applications, automation tools, and technical case studies.
      </p>
    </section>

    <section id="contact" class="scroll-mt-24 py-20">
      <h2 class="text-2xl font-semibold">Contact</h2>
      <p class="mt-3 text-muted">
        Professional contact information and profile links.
      </p>
    </section>
  </main>
</BaseLayout>
