
---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Software Developer & IT Professional | Portfolio"
  description="Explore my software development projects, technical skills, and professional IT experience."
>
  <main class="mx-auto max-w-5xl px-6 py-16">
    <section class="space-y-6">
      <p class="font-mono text-sm text-primary">
        SOFTWARE DEVELOPMENT / IT
      </p>

      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
        Portfolio Design System
      </h1>

      <p class="max-w-2xl text-lg text-muted">
        Testing our reusable Astro layout, semantic colors,
        typography, responsive styling, and theme foundation.
      </p>

      <div class="rounded-xl border border-border bg-surface p-6">
        <h2 class="text-2xl font-semibold">
          Example Project Card
        </h2>

        <p class="mt-3 text-muted">
          This content is rendered inside our shared BaseLayout
          component using Astro's slot system.
        </p>

        <a
          href="#testing"
          class="mt-5 inline-block rounded-lg border border-border
                 bg-surface px-5 py-3 font-medium text-foreground
                 hover:bg-background focus-visible:outline-offset-4"
        >
          Test Navigation
        </a>
      </div>
    </section>

    <section id="testing" class="mt-24">
      <h2 class="text-2xl font-semibold">
        Layout Testing
      </h2>

      <p class="mt-3 text-muted">
        The shared Astro layout is working correctly.
      </p>
    </section>
  </main>
</BaseLayout>
