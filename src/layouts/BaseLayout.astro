---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title, 
  description = "Personal portfolio showcasing software development projects and professional IT experience.",
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    
  <script is:inline>
    (() => {
      const root = document.documentElement;

      try {
        const savedTheme = localStorage.getItem("portfolio-theme");

        if (savedTheme === "light" || savedTheme === "dark") {
          root.dataset.theme = savedTheme;
        }
      } catch {
        // If storage is unavailable, CSS follows the system theme.
      }
      })();
  </script>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta name="description" content={description} />

    <title>{title}</title>
  </head>

  <body>
    <Header />

    <slot />
  </body>
</html>