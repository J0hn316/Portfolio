---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title, 
  description = "Personal portfolio showcasing software development projects and professional IT experience.",
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta name="description" content={description} />

    <title>{title}</title>
  </head>

  <body>
    <Header />

    <slot />
  </body>
</html>